# Copy to `.env.local` for local dev. Set the same keys in Vercel project settings for production.

# --- Calendly (appointment picker + /api/availability) ---
# Integration PAT: needs at least event_types:read + availability:read (users:read optional; only if you call /users/me).
CALENDLY_API_TOKEN=
# UUID from event type resource URI: .../event_types/{CALENDLY_EVENT_TYPE_UUID} (not the scheduling URL slug).
CALENDLY_EVENT_TYPE_UUID=
# From https://calendly.com/{NEXT_PUBLIC_CALENDLY_USERNAME}/{NEXT_PUBLIC_CALENDLY_EVENT_TYPE_SLUG}
NEXT_PUBLIC_CALENDLY_USERNAME=
NEXT_PUBLIC_CALENDLY_EVENT_TYPE_SLUG=

# Optional: canonical site URL for metadata
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Contact form: SMTP via POST /api/contact (server-only; no public URL needed) ---
# Any SMTP provider works (Gmail with App Password, Google Workspace SMTP relay, SES, Mailgun, Mailtrap for dev, etc.).
SMTP_HOST=
SMTP_PORT=587
# Use true for port 465 (SSL). For 587 STARTTLS, use false or omit.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Inbox that receives inquiry emails (e.g. tutoring address).
CONTACT_TO_EMAIL=tutoring.dta@gmail.com
# From address used by the SMTP server (defaults to SMTP_USER if omitted).
CONTACT_FROM=

# --- GitHub Actions static deploy (.github/workflows/github-pages.yml) ---
# Workflow runs on branch `github-pages` only (not `main`). Merge `main` into
# `github-pages` and push to update the static site. CI sets STATIC_EXPORT,
# NEXT_PUBLIC_STATIC_EXPORT, NEXT_PUBLIC_BASE_PATH, NEXT_PUBLIC_SITE_URL.
# Optional repository Variables: NEXT_PUBLIC_CALENDLY_USERNAME, NEXT_PUBLIC_CALENDLY_EVENT_TYPE_SLUG
# (Settings → Secrets and variables → Actions → Variables). The static site has no /api routes;
# booking uses the Calendly popup only.
