# Copy to `.env.local` for local dev. Set the same keys in Vercel project settings for production.
#
# Vercel: do NOT set STATIC_EXPORT or NEXT_PUBLIC_STATIC_EXPORT (GitHub Pages only).
# Project Root Directory must be `dta-app` (see dta-app/DEPLOY.md).

# --- Calendly inline embed (active on /contact) ---
# https://calendly.com/{NEXT_PUBLIC_CALENDLY_USERNAME}/{NEXT_PUBLIC_CALENDLY_EVENT_TYPE_SLUG}
NEXT_PUBLIC_CALENDLY_USERNAME=
NEXT_PUBLIC_CALENDLY_EVENT_TYPE_SLUG=

# --- Calendly Scheduling API (parked: appointment-picker.custom.tsx + /api/availability + /api/book) ---
# Personal access token scopes: event_types:read, availability:read, scheduled_events:write.
# Scheduling API (POST /invitees) requires a paid Calendly plan — see developer.calendly.com.
CALENDLY_API_TOKEN=
# UUID from event type resource URI: .../event_types/{CALENDLY_EVENT_TYPE_UUID} (not the scheduling URL slug).
CALENDLY_EVENT_TYPE_UUID=
# Optional: force meeting location kind for POST /invitees (e.g. google_conference, zoom_conference).
# If omitted, we use the kind when the event type has exactly one location configured.
# CALENDLY_LOCATION_KIND=google_conference

# Optional: canonical site URL for metadata
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Contact form: SMTP via POST /api/contact (server-only; no public URL needed) ---
# Any SMTP provider works (Gmail with App Password, Google Workspace SMTP relay, SES, Mailgun, Mailtrap for dev, etc.).
SMTP_HOST=
SMTP_PORT=587
# Use true for port 465 (SSL). For 587 STARTTLS, use false or omit.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Inbox that receives contact-form and office-hours signup emails (e.g. tutoring address).
CONTACT_TO_EMAIL=tutoring.dta@gmail.com
# From address used by the SMTP server (defaults to SMTP_USER if omitted).
CONTACT_FROM=

# --- Office hours calendar (public iCal URL, not the Google embed) ---
# Google Calendar → Settings and sharing → Integrate calendar → Public address in iCal format.
# Must end in /basic.ics. Server-only; never NEXT_PUBLIC_.
# Optional: the app already ships the public Office Hours feed as a default.
# Set this only to override that URL (Vercel env is not required for the default).
OFFICE_HOURS_ICS_URL=

# --- Notion API (server-only) ---
# Internal integration secret from https://www.notion.so/profile/integrations.
# Share each target page/database with the integration or requests return 404.
NOTION_API_KEY=
# Session Calendar database or data source ID (32-char hex from the database URL works).
NOTION_SESSIONS_DATA_SOURCE_ID=
# Student Database ID for office hours signups; only pages with Status = Active can book.
NOTION_STUDENTS_DATA_SOURCE_ID=
# Token Notion sends when the webhook subscription is created (logged by /api/webhooks/notion).
NOTION_WEBHOOK_VERIFICATION_TOKEN=

# --- Google Calendar: Session Calendar sync (server-only) ---
# Service account with Calendar API enabled; share each tutor calendar with its email
# ("Make changes to events"). Paste the private key with literal \n escapes on one line.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Calendar IDs from Google Calendar > Settings > Integrate calendar.
GCAL_CALENDAR_ID_AYUSH_BANDOPADHYAY=
GCAL_CALENDAR_ID_AYUSH_BAKHANDI=
# Office hours calendar that receives signup events (share with the service account: "Make changes to events").
OFFICE_HOURS_CALENDAR_ID=
# Accounting spreadsheet ID (from /spreadsheets/d/{ID}/edit). Needs the Sheets API enabled
# on the service account's project and the sheet shared with its email as Editor.
GOOGLE_SHEETS_ACCOUNTING_ID=
# Vercel cron sends `Authorization: Bearer $CRON_SECRET` to /api/sync/sessions.
CRON_SECRET=

# --- GitHub Actions static deploy (.github/workflows/github-pages.yml) ---
# Workflow runs on branch `github-pages` only (not `main`). Merge `main` into
# `github-pages` and push to update the static site. CI sets STATIC_EXPORT,
# NEXT_PUBLIC_STATIC_EXPORT, NEXT_PUBLIC_BASE_PATH, NEXT_PUBLIC_SITE_URL.
# The static GitHub Pages build has no /api routes; the contact page shows email-only booking there.
